      var vp=(lat.getAttribute("data-lattes")||"300 250").split(" ").map(Number), pas=+(lat.getAttribute("data-pas")||56);
      for(var xb=-900;xb<=1500;xb+=pas){var ln=el("path","",lat);ln.setAttribute("d","M"+vp[0]+" "+vp[1]+"L"+xb+" 720");}
      var jt=lat.getAttribute("data-joints");
      if(jt)jt.split(" ").map(Number).forEach(function(y,ix){for(var xx=(ix%2)*40;xx<600;xx+=120+ix*10){var s2=el("path","",lat);s2.setAttribute("d","M"+xx+" "+y+"h"+(18+ix*4));}});
      var hz=lat.getAttribute("data-horiz");
      if(hz)hz.split(" ").map(Number).forEach(function(y){var s3=el("path","",lat);s3.setAttribute("d","M0 "+y+"H600");});
    }
    var pou=$("[data-poussiere]",studio);
    if(pou){
      var z=(pou.getAttribute("data-poussiere")||"120 220 380 420 22").split(" ").map(Number);
      for(var pi=0;pi<(z[4]||22);pi++){var cc=el("circle","",pou);cc.setAttribute("cx",(z[0]+Math.random()*z[2]).toFixed(0));cc.setAttribute("cy",(z[1]+Math.random()*z[3]).toFixed(0));cc.setAttribute("r",(.8+Math.random()*1.6).toFixed(1));cc.style.animationDuration=(7+Math.random()*9).toFixed(1)+"s";cc.style.animationDelay=(-Math.random()*12).toFixed(1)+"s";}
    }
    var ref=$("[data-reflets]",studio), ds=[], decal=[];
    $$("[data-fig]",studio).forEach(function(ph,ix){
      var cfg=lire(ph); if(!cfg)return;
      var w=el("g","",ph);w.setAttribute("transform","translate("+(cfg.x||0)+" "+(cfg.y||0)+") scale("+(cfg.sx||cfg.s||1)+" "+(cfg.s||1)+")");
      var d=new Figure(cfg,w);
      if(ref&&cfg.reflet){var id="fig"+ix;d.g.setAttribute("id",id);var u=el("use","",ref);u.setAttribute("href","#"+id);var r2=cfg.reflet;u.setAttribute("transform","translate("+r2[0]+" "+r2[1]+") scale("+r2[2]+" "+(-r2[2])+")");}
      ds.push(d);decal.push(cfg.dec||0);
    });
    var T0=performance.now(),dern=T0,actif=true,acc=0;
    ds.forEach(function(d,ix){d.dessin(decal[ix],240);});
    if(!reduit&&ds.length){
      if("IntersectionObserver" in window){new IntersectionObserver(function(es){actif=es[0].isIntersecting;},{threshold:0}).observe(studio);}
      var boucle=function(now){
        requestAnimationFrame(boucle);
        if(!actif||document.hidden){dern=now;return;}
        var dt=Math.min(now-dern,60);dern=now;acc+=dt;
        var steps=Math.min(Math.round(acc/16.67),3);if(steps<1)return;acc-=steps*16.67;
        var T=(now-T0)/1000;
        ds.forEach(function(d,ix){d.dessin(T+decal[ix],steps);});
      };
      requestAnimationFrame(boucle);
    }
  }
  /* Vignettes fixes des arches */
  $$(".arche [data-fig]").forEach(function(sv){
    var cfg=lire(sv); if(!cfg)return;
    var g=el("g","",sv);g.setAttribute("transform","translate("+(cfg.x||0)+" "+(cfg.y||0)+") scale("+(cfg.s||1.05)+")");
    if(cfg.ombre!==false){var ombre=el("ellipse","",g);ombre.setAttribute("cx",0);ombre.setAttribute("cy",2);ombre.setAttribute("rx",46);ombre.setAttribute("ry",5);ombre.setAttribute("fill","rgba(94,26,43,.12)");}
    var d=new Figure(cfg,g);d.t.rebond=false;
    var T=(d.t.tr+d.t.hold)*(cfg.fixe||0);
    for(var zz=0;zz<6;zz++)d.dessin(T,60);
  });

  window.__cadence=1;
})();
</script>
</body>
</html>
