{{ cordeau(false) }}

<section class="sec millimetre" id="demande" aria-labelledby="t-prep">
  <div class="env">
    <div class="tete">
      <div class="apparait">
        <p class="surt">Avant d'appeler</p>
        <h2 id="t-prep">Préparer votre demande</h2>
      </div>
      <p class="chapo apparait" style="--d:.12s">Trois choses à avoir en tête avant d'écrire ou d'appeler. Elles rendent le premier échange beaucoup plus utile.</p>
    </div>
    <ol class="etapes">
      <li class="etape apparait" style="--d:0s">
        <span class="cote">2 ou 3 phrases</span>
        <div class="etape__ic"><svg viewBox="0 0 36 36" fill="none" stroke="#171C20" stroke-width="1.6" aria-hidden="true"><path class="trace" pathLength="1" d="M5 9h16M5 15h12M5 21h8"/><path class="trace" pathLength="1" style="--d:.3s" d="M28 8l4 4-13 13-5 1 1-5z" stroke="#2347D9"/></svg></div>
        <h3>Décrire</h3>
        <p>Ce qui ne va pas, ou ce que vous voulez faire, en deux ou trois phrases.</p>
      </li>
      <li class="etape apparait" style="--d:.15s">
        <span class="cote">Ensemble + détail</span>
        <div class="etape__ic"><svg viewBox="0 0 36 36" fill="none" stroke="#171C20" stroke-width="1.6" aria-hidden="true"><path class="trace" pathLength="1" d="M4 12h6l3-4h10l3 4h6v16H4z"/><circle class="trace" pathLength="1" style="--d:.3s" cx="18" cy="19" r="5.5" stroke="#2347D9"/></svg></div>
        <h3>Photographier</h3>
        <p>Une vue d'ensemble et une vue de près : elles évitent souvent un déplacement pour rien.</p>
      </li>
      <li class="etape apparait" style="--d:.3s">
        <span class="cote">Commune + créneaux</span>
        <div class="etape__ic"><svg viewBox="0 0 36 36" fill="none" stroke="#171C20" stroke-width="1.6" aria-hidden="true"><path class="trace" pathLength="1" d="M3 30l9-4 12 4 9-4V6l-9 4-12-4-9 4z"/><path class="trace" pathLength="1" style="--d:.3s" d="M18 23s5-4.5 5-8.5a5 5 0 0 0-10 0c0 4 5 8.5 5 8.5z" stroke="#2347D9" fill="#F5F7F7"/></svg></div>
        <h3>Situer</h3>
        <p>La commune du chantier et vos disponibilités pour une visite.</p>
      </li>
    </ol>
  </div>
</section>

<section class="sec" id="horaires" aria-labelledby="t-hor" style="background:var(--calque-2)">
  <div class="env">
    <div class="tete">
      <div class="apparait">
        <p class="surt">Horaires et accès</p>
        <h2 id="t-hor">Joindre l'entreprise</h2>
      </div>
      <p class="chapo apparait" style="--d:.12s">{% if sem %}L'état affiché se calcule à l'heure où vous lisez la page. {% endif %}{{ prof.chantier }}</p>
    </div>
    <div class="duo">
      <div class="pan apparait">
        <div class="pan__h"><span>Planning de la semaine</span><span id="jour">Aujourd'hui</span></div>
        <div class="pan__c">
          <h3>Horaires</h3>
          {% if sem %}
          <p class="etat" id="etat2" data-h="{{ data_h }}">{{ r.jours }}, {{ r.principal_et }}.</p>
          {% set lo = [360, (r.debut // 60) * 60]|min %}
          {% set hi = [1200, ((r.fin + 59) // 60) * 60]|max %}
          {% set span = hi - lo %}
          <dl class="hor" id="hor">
            {% for j in semaine %}
            <div{% if not j.ouvert %} class="hor--off"{% endif %}><dt>{{ j.jour|capitalize }}</dt><dd>{{ j.texte }}</dd><span class="barre" aria-hidden="true" style="--n:{{ span // 60 }}">{% for a, b in j.creneaux %}<i style="left:{{ '%.2f'|format((a - lo) * 100 / span) }}%;width:{{ '%.2f'|format((b - a) * 100 / span) }}%"></i>{% endfor %}</span></div>
            {% endfor %}
          </dl>
          <div class="hor__ech" aria-hidden="true"><span>{{ lo // 60 }} h</span><span>{{ (lo + hi) // 120 }} h{% if ((lo + hi) // 2) % 60 %} 30{% endif %}</span><span>{{ hi // 60 }} h</span></div>
          {% else %}
          <p class="etat"><span class="pastille" aria-hidden="true"></span>Horaires sur demande</p>
          <p class="pan__n">Les horaires ne sont pas encore indiqués ici. Un message ou un appel suffit : vous convenez directement d'un moment pour échanger ou pour une visite.</p>
          {% endif %}
        </div>
      </div>
      <div class="pan acces apparait" style="--d:.12s">
        <div class="pan__h"><span>Plan d'accès</span><span>{{ court }}</span></div>
        <svg class="revele" viewBox="0 0 400 230" role="img" aria-label="Plan d'accès schématique : l'entreprise se trouve rue de l'Exemple{{ al }}">
  <defs><pattern id="ilot" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path d="M0 0V6" stroke="#C6CDD1" stroke-width="1"/></pattern></defs>
  <g fill="url(#ilot)" stroke="#9AA4AB" stroke-width="1">
    <path d="M20 20H150V80H20Z"/><path d="M178 20H300L280 80H178Z"/><path d="M326 20H390V120L306 92Z"/>
    <path d="M20 108H150V200H20Z"/><path d="M178 108H268L240 200H178Z"/><path d="M296 120L390 150V210H268Z"/>
  </g>
  <g fill="none" stroke="#171C20" stroke-linecap="round">
    <path class="trace" pathLength="1" d="M0 94H400" stroke-width="1.2" style="--d:.1s"/>
    <path class="trace" pathLength="1" d="M164 0V230" stroke-width="1.2" style="--d:.2s"/>
    <path class="trace" pathLength="1" d="M314 0L254 230" stroke-width="1.2" style="--d:.3s"/>
  </g>
  <path class="trace" pathLength="1" d="M0 94H400" stroke="#2347D9" stroke-width="5" style="--d:.5s"/>
  <text x="24" y="90" font-size="10" fill="#2347D9" font-weight="600" letter-spacing="1">RUE DE L'EXEMPLE</text>
  <g class="fondu" style="--d:1s">
    <circle cx="232" cy="94" r="22" fill="rgba(35,71,217,.14)"/>
    <path d="M232 98 l-12 -12 v-14 h24 v14z" fill="#2347D9"/>
    <path d="M224 80 l8 -7 8 7 M226 79 v6 h12 v-6" fill="none" stroke="#fff" stroke-width="1.6"/>
    <text x="250" y="76" font-size="11" font-weight="600" fill="#171C20">XX</text>
  </g>
  <g transform="translate(370 194)"><circle r="14" fill="#F5F7F7" stroke="#171C20"/><path d="M0 -9 L4 3 L0 0 L-4 3Z" fill="#171C20"/><text y="-18" text-anchor="middle" font-size="9" fill="#171C20">N</text></g>
</svg>
        <div class="pan__c">
          <h3>Venir à l'entreprise</h3>
          <address class="adr">XX rue de l'Exemple{% if cpc %}<br>{{ cpc }}{% endif %}</address>
          <div class="pan__a">
            <a class="btn" href="{{ itin }}">Ouvrir l'itinéraire <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>
            <a class="btn btn--trait" href="#contact">Prévenir avant de passer</a>
          </div>
          <p class="pan__n">Les horaires peuvent changer les jours fériés : un message avant de venir ne coûte rien.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sec nuit millimetre" id="contact" aria-labelledby="t-ctc">
  <div class="env ctc">
    <div class="apparait">
      <p class="surt">Contact</p>
      <h2 id="t-ctc" class="{{ c_cls }}">Écrire à {{ N }}</h2>
      {% if a_tel %}<a class="ctc__tel" href="#contact"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2"/></svg>{{ tel }}</a>{% endif %}
      <p class="ctc__l">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
        <span><b>XX rue de l'Exemple</b>{{ cpc }}</span>
      </p>
      <p class="ctc__l">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        {% if sem %}<span><b>{{ r.jours }}</b>{{ r.principal_et }}{% if r.exceptions %} ; {{ r.exceptions }}{% endif %}</span>{% else %}<span><b>Horaires sur demande</b>Un message, et l'entreprise vous répond.</span>{% endif %}
      </p>
      <p class="ctc__dir">{{ fam.ouverture }} Pas de standard, pas d'intermédiaire.</p>
    </div>

    <form class="bon apparait" style="--d:.12s" id="dem" novalidate>
      <div class="bon__h"><span>Bon de demande</span><span class="bon__n">{{ N }}</span></div>
      <div class="bon__c">
        <h3>{{ fam.cta }}</h3>
        <p class="bon__s">Votre message arrive directement chez {{ N }}, qui vous répond.</p>
        <div class="ch">
          <div class="f"><label for="nom">Votre nom</label>
            <input id="nom" name="nom" type="text" autocomplete="name" required placeholder="Camille Renard"></div>
          <div class="f"><label for="tel">Téléphone ou courriel</label>
            <input id="tel" name="tel" type="text" autocomplete="tel" required placeholder="Pour vous répondre"></div>
          <div class="f"><label for="commune">Commune du chantier</label>
            <input id="commune" name="commune" type="text" autocomplete="address-level2" placeholder="{{ court or "Votre commune" }}…"></div>
          <div class="f"><label for="objet">Votre demande</label>
            <select id="objet" name="objet">
              <option value="">Choisir…</option>
              {% for c in fam.choix %}
              <option>{{ c }}</option>
              {% endfor %}
            </select></div>
        </div>
        <div class="f"><label for="det">Quelques mots</label>
          <textarea id="det" name="det" rows="4" placeholder="Ce qui ne va pas, ou ce que vous voulez faire."></textarea></div>
        <button class="btn" type="submit">Envoyer la demande <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></button>
        <p class="fret" id="ret" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>

<!-- BON DE TRAVAIL : pour François, jamais pour le prospect (visible avec ?notes). -->
<section class="perso" id="a-personnaliser" aria-labelledby="t-perso">
  <div class="env sec">
    <h2 id="t-perso">Ce qui reste à faire confirmer</h2>
    <p>Tout ce qui figure plus haut provient de sources publiques. Rien n'a été inventé : ni tarif, ni garantie, ni avis, ni spécialité. <strong>Cette section n'est visible que par vous.</strong></p>
    <ul>
      <li><b>Prestations réelles</b>Les planches décrivent le métier en général. À remplacer par ce que fait vraiment l'entreprise.</li>
      <li><b>Zone d'intervention</b>Le schéma est centré sur la commune, sans liste de communes : à compléter avec celles que l'entreprise dessert vraiment.</li>
      <li><b>Horaires</b>{% if sem %}L'indicateur « ouvert maintenant » se calcule sur les horaires affichés.{% else %}Aucun horaire public trouvé : « Horaires sur demande » en attendant.{% endif %}</li>
      <li><b>Photos</b>La page n'en contient aucune. Trois ou quatre photos de chantier prises au téléphone valent mieux que n'importe quelle illustration.</li>
      <li><b>Avis, labels, tarifs</b>À afficher seulement s'ils existent et sont vérifiables.</li>
    </ul>
  </div>
</section>
</main>

<footer class="pied">
  <div class="env">
    <div class="cartouche{% if not a_tel %} cartouche--3{% endif %}">
      <div><small>Entreprise</small><span class="nm">{{ N }}</span></div>
      <div><small>Activité</small><b>{{ activite }}</b></div>
      <div><small>Adresse</small><b>XX rue de l'Exemple</b>{% if cpc %}<br>{{ cpc }}{% endif %}</div>
      {% if a_tel %}<div><small>Téléphone</small><b>{{ tel }}</b></div>{% endif %}
    </div>
    <div class="pied__b"><span>© {{ annee }} {{ N }}{% if cpc %}, {{ cpc }}{% endif %}</span>{% if sem %}<span>Horaires relevés sur OpenStreetMap</span>{% endif %}</div>
  </div>
</footer>

<div class="bmob" id="bmob">
  {% if a_tel %}<a class="bmob__t" href="#contact"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2"/></svg>Appeler</a>{% else %}<a class="bmob__t" href="#horaires">Horaires</a>{% endif %}
  <a class="bmob__d" href="#contact">{{ fam.cta }}</a>
</div>

<script>
(function(){
  var NOM = {{ nom_js }};
  var reduit = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
  var fin = window.matchMedia && matchMedia("(pointer: fine)").matches;

  /* --- ouvert / fermé --- */
  var J=["dimanche","lundi","mardi","mercredi","jeudi","vendredi","samedi"];
  function pr(x){var r=[],i; if(!x) return r; for(i=0;i+1<x.length;i+=2) r.push([x[i],x[i+1]]); return r;}
  function hm(v){var a=Math.floor(v/60),b=v%60; return b? a+" h "+(b<10?"0":"")+b : a+" h";}
  function ecrire(el,txt,cls){el.textContent=txt; el.insertAdjacentHTML("afterbegin",'<span class="pastille" aria-hidden="true"></span>'); el.className="etat "+cls;}
  function poser(el){
    var h; try{ h=JSON.parse(el.getAttribute("data-h")); }catch(e){ return; }
    if(!Array.isArray(h)||h.length!==7) return;
    var d=new Date(),j=d.getDay(),m=d.getHours()*60+d.getMinutes(),i,k,jj,cs,cj=pr(h[j]);
    for(i=0;i<cj.length;i++){ if(m>=cj[i][0]&&m<cj[i][1]){ ecrire(el,"Ouvert, jusqu'à "+hm(cj[i][1]),"etat--oui"); return; } }
    for(k=0;k<8;k++){ jj=(j+k)%7; cs=pr(h[jj]);
      for(i=0;i<cs.length;i++){ if(k===0&&cs[i][0]<=m) continue;
        ecrire(el,"Fermé, ouvre "+(k===0?"à ":(k===1?"demain à ":J[jj]+" à "))+hm(cs[i][0]),"etat--non"); return; } }
  }
  document.querySelectorAll(".etat[data-h]").forEach(poser);
  var t=document.getElementById("jour"), auj=new Date().getDay();
  if(t){ var n=J[auj]; t.textContent="Aujourd'hui : "+n; }
  var l=document.querySelectorAll("#hor > div");
  if(l.length>=7) l[(auj+6)%7].classList.add("hor--jour");

  /* --- formulaire --- */
  var f=document.getElementById("dem");
  if(f) f.addEventListener("submit",function(e){
    e.preventDefault();
    var r=document.getElementById("ret");
    if(!f.nom.value.trim()||!f.tel.value.trim()){ r.textContent="Indiquez au moins votre nom et un moyen de vous répondre."; (f.nom.value.trim()?f.tel:f.nom).focus(); return; }
    r.textContent="Merci. Sur le site en ligne, votre demande arrive directement chez "+NOM+".";
    f.reset();
  });

  /* --- bon de travail --- */
  var b=document.getElementById("a-personnaliser");
  if(b&&(/[?&]notes(=|&|$)/.test(location.search)||location.hash==="#notes")) b.classList.add("ouvert");

  /* --- menu mobile --- */
  var bg=document.getElementById("burger"), mn=document.getElementById("menu");
  function menu(o){ bg.setAttribute("aria-expanded",o?"true":"false"); bg.setAttribute("aria-label",o?"Fermer le menu":"Ouvrir le menu"); mn.classList.toggle("ouvert",o); }
  if(bg&&mn){
    bg.addEventListener("click",function(){ menu(bg.getAttribute("aria-expanded")!=="true"); });
    mn.querySelectorAll("a").forEach(function(a){ a.addEventListener("click",function(){ menu(false); }); });
    document.addEventListener("keydown",function(e){ if(e.key==="Escape") menu(false); });
  }

  /* --- carte : communes --- */
  var noeuds={}; document.querySelectorAll("#carte .c-n").forEach(function(g){ noeuds[g.getAttribute("data-c")]=g; });
  var puces=document.querySelectorAll(".communes button");
  function montrer(c){
    puces.forEach(function(p){ p.setAttribute("aria-pressed", p.getAttribute("data-c")===c ? "true":"false"); });
    Object.keys(noeuds).forEach(function(k){ noeuds[k].classList.toggle("on",k===c); });
  }
  puces.forEach(function(p){
    var c=p.getAttribute("data-c");
    p.addEventListener("click",function(){ montrer(p.getAttribute("aria-pressed")==="true"?null:c); });
    p.addEventListener("mouseenter",function(){ if(fin) montrer(c); });
  });
  Object.keys(noeuds).forEach(function(k){ noeuds[k].addEventListener("mouseenter",function(){ montrer(k); }); });

  /* --- en-tête, barre mobile --- */
  var hdr=document.getElementById("hdr"), bm=document.getElementById("bmob");
  function surDefil(){ hdr.classList.toggle("defile", scrollY>8); }
  addEventListener("scroll",surDefil,{passive:true}); surDefil();

  /* --- cordeau claqué --- */
  function claquer(c){
    var fil=c.querySelector(".fil"); if(!fil) return;
    if(reduit){ c.classList.add("claque"); return; }
    var t0=null, tir=260;
    function pas(ts){
      if(t0===null) t0=ts; var t=ts-t0, y;
      if(t<tir){ var p=t/tir; y=20-16*(1-Math.pow(1-p,3)); }
      else { var s=(t-tir)/1000; y=20-16*Math.exp(-s*5.2)*Math.cos(s*2*Math.PI*6.5); if(!c.classList.contains("claque")&&y>20) c.classList.add("claque"); }
      fil.setAttribute("d","M0 20 Q500 "+y.toFixed(2)+" 1000 20");
      if(t<tir+1300) requestAnimationFrame(pas); else fil.setAttribute("d","M0 20 Q500 20 1000 20");
    }
    requestAnimationFrame(pas);
  }

  /* --- révélations --- */
  var aRev=document.querySelectorAll(".apparait, .revele, .etapes"), cords=document.querySelectorAll(".cordeau");
  if(!("IntersectionObserver" in window)||reduit){
    aRev.forEach(function(e){e.classList.add("vu");}); cords.forEach(function(c){c.classList.add("claque");});
  } else {
    var io=new IntersectionObserver(function(ent){ ent.forEach(function(x){ if(x.isIntersecting){ x.target.classList.add("vu"); io.unobserve(x.target);} }); },{rootMargin:"0px 0px -10% 0px"});
    aRev.forEach(function(e){io.observe(e);});
    var ic=new IntersectionObserver(function(ent){ ent.forEach(function(x){ if(x.isIntersecting){ claquer(x.target); ic.unobserve(x.target);} }); },{rootMargin:"0px 0px -18% 0px"});
    cords.forEach(function(c){ic.observe(c);});
  }
  if("IntersectionObserver" in window && bm){
    var ib=new IntersectionObserver(function(ent){ ent.forEach(function(x){ bm.classList.toggle("cache", x.isIntersecting); }); },{threshold:.25});
    var ct=document.getElementById("dem"); if(ct) ib.observe(ct);
  }

  /* --- réticule et parallaxe du hero --- */
  var plan=document.getElementById("plan"), ret=document.getElementById("reticule"), ouv=document.getElementById("ouv");
  if(fin && !reduit && plan && ret){
    var lab=ret.querySelector("b");
    plan.addEventListener("pointermove",function(e){
      var r=plan.getBoundingClientRect(), x=e.clientX-r.left, y=e.clientY-r.top;
      ret.style.setProperty("--x",x+"px"); ret.style.setProperty("--y",y+"px");
      var vx=Math.round(x/r.width*680), vy=Math.round(y/r.width*680);
      lab.textContent="X "+("000"+vx).slice(-4)+"  Y "+("000"+vy).slice(-4);
      ret.classList.add("on");
    });
    plan.addEventListener("pointerleave",function(){ ret.classList.remove("on"); });
  }
  if(!reduit && ouv){
    var svgp=plan&&plan.querySelector("svg"), tic=false;
    addEventListener("scroll",function(){
      if(tic) return; tic=true;
      requestAnimationFrame(function(){
        var y=Math.min(scrollY,900);
        ouv.style.setProperty("--gp","0 "+(y*.35).toFixed(1)+"px");
        if(svgp && innerWidth>=960) svgp.style.transform="translateY("+(y*.06).toFixed(1)+"px)";
        tic=false;
      });
    },{passive:true});
  }

  window.__pret=true;
})();
</script>
</body>
</html>
